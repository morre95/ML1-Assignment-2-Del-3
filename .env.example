# Required for live OpenRouter calls.
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Optional runtime overrides.
REACT_AGENT_MODEL=openai/gpt-5.4-mini
REACT_AGENT_HTTP_REFERER=http://localhost
REACT_AGENT_APP_TITLE=ReAct Agent System
REACT_AGENT_SESSION_DB=sessions/agent-history.sqlite3

# Optional RunPod hub/team mode settings.
REACT_AGENT_HUB_URL=https://z0yncxbipft4e8-8080.proxy.runpod.net
REACT_AGENT_HUB_PASSWORD=replace-with-hub-password
REACT_AGENT_HUB_AGENT_NAME=cryptofarian-builder
REACT_AGENT_HUB_ALIASES=ema,erik,builder
REACT_AGENT_HUB_AGENT_ROLE=You are a concise software-building agent in a group chat.
# Set to false to disable the input/output token budget caps in hub mode.
REACT_AGENT_HUB_TOKEN_BUDGET=true
